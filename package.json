{
  "name": "interactive-lanyard-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint",
    "fix": "ultracite fix",
    "check": "ultracite check",
    "typecheck": "tsc --noEmit",
    "preview": "vite build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "vite build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "@vinext/cloudflare": "^1.2.0",
    "meshline": "^3.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "three": "^0.182.0",
    "vinext": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@cloudflare/vite-plugin": "1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "7.0.12",
    "vite": "^8.3.5",
    "wrangler": "^4.149.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "type": "module",
  "overrides": {
    "sharp": "^0.35.5"
  }
